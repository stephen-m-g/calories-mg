# Copy this file to .env and fill in real values. Never commit .env.
# All keys must be prefixed EXPO_PUBLIC_ to be readable by the Expo client at runtime.
# NOTE: these keys ship inside the built app binary (no backend server, see PROJECT_PLAN.md §3).
# Acceptable here only because this app is personal/internal-distribution and all services are free-tier.

# USDA FoodData Central API key — free, get one at https://api.data.gov/signup/
EXPO_PUBLIC_USDA_FDC_API_KEY=

# Groq API key (Whisper large-v3 transcription) — free tier, get one at https://console.groq.com/keys
EXPO_PUBLIC_GROQ_API_KEY=

# Google Gemini API key (Flash — parsing, photo recognition, label OCR) — free tier, get one at https://aistudio.google.com/apikey
# IMPORTANT: create this key from AI Studio itself, NOT from the Google Cloud Console credentials
# page — a Cloud-Console-created key lands on a prepay tier and fails with 429 until funded.
EXPO_PUBLIC_GEMINI_API_KEY=

# WHOOP OAuth app credentials (optional — only needed for automatic calories-burned / deficit mode).
# Create an app at https://developer.whoop.com, request scopes "read:cycles" and "offline",
# and register the redirect URI  caloriemate://whoop-callback
# NOTE: that redirect only resolves in a development/production build. Expo Go uses an
# exp://<lan-ip>:8081/--/whoop-callback style URL instead, which changes with your network.
EXPO_PUBLIC_WHOOP_CLIENT_ID=
EXPO_PUBLIC_WHOOP_CLIENT_SECRET=
